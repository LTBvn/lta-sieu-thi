# Sao chép file này thành .env rồi điền giá trị. File .env KHÔNG được đưa lên git.

PORT=4000

# --- Đăng nhập Google ---
# Tạo tại https://console.cloud.google.com/apis/credentials → Create credentials → OAuth client ID → Web application
# Authorized JavaScript origins: http://localhost:5173
GOOGLE_CLIENT_ID=

# --- Đăng nhập Facebook ---
# Tạo tại https://developers.facebook.com/apps → Create app → thêm sản phẩm "Facebook Login" (Web)
# Valid OAuth Redirect URIs / App Domains: localhost
FACEBOOK_APP_ID=

# --- Bảo mật ---
# Để trống thì backend tự tạo và lưu trong data/.jwt-secret
JWT_SECRET=

# --- Tài khoản admin tạo ở lần chạy ĐẦU TIÊN (database trống) ---
ADMIN_USERNAME=LTAadmin
ADMIN_PASSWORD=adminLTA
ADMIN_PHONE=0900000000

# production = tắt chế độ OTP giả lập
NODE_ENV=development
